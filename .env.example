# Copy to .env.local and fill in. Never commit real values.
# Adding a variable? Update this file, src/lib/env.schema.ts and Vercel (Preview + Production).

# Database (Supabase). DATABASE_URL = pooled connection, DIRECT_URL = direct connection for migrations
DATABASE_URL=
DIRECT_URL=

# Auth.js: generate with `npx auth secret` or `openssl rand -base64 32`
AUTH_SECRET=

# Public base URL, used for QR scan links and emails (http://localhost:3000 locally)
NEXT_PUBLIC_APP_URL=

# Cron endpoints (/api/cron/*): Bearer secret for the GitHub Actions expiry/cleanup jobs. Generate with `openssl rand -base64 32`
CRON_SECRET=

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=
SUPABASE_STORAGE_BUCKET=